# Optimus Envíos — API Python. Usa los MISMOS nombres de variables que api/v1/.env (reemplazo directo).
# Copiar a backend/.env (nunca versionar) o definir como variables del servidor. Ver api/v1/.env.example
# para la descripción de cada una. Precedencia: entorno > backend/.env > api/v1/.env.
APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=optimus
DB_USER=optimus_app
DB_PASS=
JWT_SECRET=            # >= 32 caracteres aleatorios (openssl rand -hex 48); la API no arranca sin él
DATA_ENC_KEY=          # 32 bytes en base64 (openssl rand -base64 32)
CORS_ORIGIN=http://localhost:5173
TRUSTED_PROXIES=       # IPs del proxy/balanceador que añade X-Forwarded-*; vacío = sin proxy
UPLOAD_DIR=            # ruta ABSOLUTA fuera del directorio web
UPLOAD_MAX_MB=5
TERMS_VERSION=v0-pendiente
# bcrypt mientras exista la posibilidad de volver al backend PHP; argon2id tras el corte definitivo
PASSWORD_ALGO=bcrypt
