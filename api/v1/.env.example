APP_ENV=development
APP_URL=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=packexpress_shop
DB_USER=root
DB_PASS=

JWT_SECRET=change-this-to-a-secure-random-64-char-string
