# Optimus Envíos — API. Copiar a api/v1/.env (NUNCA versionar) o definir como variables del servidor.
# Falla CERRADO: si APP_ENV falta o no es "development"/"testing", se asume producción
# (HTTPS obligatorio, CORS estricto, errores sin detalles).
APP_ENV=development
APP_URL=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=optimus
# Usar el usuario de mínimo privilegio `optimus_app` (database/security/grants.sql), nunca root.
DB_USER=optimus_app
DB_PASS=

# Obligatorio: >= 32 caracteres aleatorios. La API se niega a arrancar con uno corto o de ejemplo.
#   openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Clave AES-256 para cifrar documentos de destinatarios (32 bytes en base64):  openssl rand -base64 32
# Guardarla fuera del repositorio y respaldarla aparte: sin ella los datos cifrados no se pueden leer.
DATA_ENC_KEY=

# Orígenes permitidos (coincidencia exacta, separados por coma). Sin comodines.
CORS_ORIGIN=http://localhost:5173
# IPs de proxies/balanceadores de confianza (habilita X-Forwarded-For / X-Forwarded-Proto). Vacío = sin proxy.
TRUSTED_PROXIES=

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT=10

UPLOAD_MAX_MB=5
# Ruta ABSOLUTA fuera del directorio web, p. ej. /home/usuario/optimus_storage/receipts
UPLOAD_DIR=
# Versión de las condiciones del servicio que acepta el cliente (pendiente de definición comercial)
TERMS_VERSION=v0-pendiente
